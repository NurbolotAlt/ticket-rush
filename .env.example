# Скопируй в .env и задай свои значения. Сам .env в git не попадает.

# Пароль PostgreSQL. Обязателен: compose откажется стартовать без него.
# Только латиница и цифры — он подставляется в DATABASE_URL без экранирования.
POSTGRES_PASSWORD=change-me

# Число gunicorn-воркеров на реплику API и размер пула к БД на каждый воркер.
# Ёмкость: реплики × WEB_CONCURRENCY × DB_POOL_MAX должно быть заметно меньше
# max_connections PostgreSQL (100) — см. комментарий в docker-compose.yml.
WEB_CONCURRENCY=2
DB_POOL_MAX=10
